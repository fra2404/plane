PORT=3200
APP_VERSION="1.4.2"
LOG_LEVEL=info
API_BASE_PATH="/discord"
# Comma separated list of allowed CORS origins. Leave empty to disable CORS.
CORS_ALLOWED_ORIGINS=""

# Discord
DISCORD_BOT_TOKEN=""
# Optional: defaults to the bot user's application id once the client is ready
DISCORD_APPLICATION_ID=""
# Optional: register slash commands only in this guild (instant updates). Leave empty for global commands.
DISCORD_GUILD_ID=""
# Optional: fallback channel when a project is not explicitly mapped
DISCORD_DEFAULT_CHANNEL_ID=""
# Optional: JSON map of Plane project UUID or project identifier to Discord channel id
# Example: {"PROJ": "123456789012345678", "4c2f...uuid": "987654321098765432"}
DISCORD_CHANNEL_MAPPING="{}"
# Optional: JSON map of Discord user id/username/tag to a Plane member id or email.
# Used by /issue list to default to the caller's own work items. Example:
# {"123456789012345678": "alice@example.com", "bob": "bob@example.com"}
DISCORD_USER_MAPPING="{}"
# Create a Discord thread for every newly created work item and route its comments there
DISCORD_AUTO_THREADS=true
# Mirror messages written in linked threads back to Plane as comments.
# Requires enabling the privileged "Message Content Intent" for the bot.
DISCORD_MIRROR_MESSAGES=false
# Where assignment notifications are delivered: "dm" (private, default),
# "channel" (post in the project channel, mention the assignee) or "both".
DISCORD_ASSIGN_DELIVERY="dm"
# Thread auto-archive duration in minutes: 60, 1440, 4320 or 10080
DISCORD_THREAD_AUTO_ARCHIVE_MINUTES=1440

# Plane
PLANE_API_BASE_URL="http://localhost:8000"
PLANE_API_TOKEN="plane_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
PLANE_WORKSPACE_SLUG="my-workspace"
# Used to build deep links in notifications. Defaults to PLANE_API_BASE_URL when empty.
PLANE_WEB_BASE_URL="http://localhost:3000"
# Webhook secret used to verify the X-Plane-Signature header.
# Point each Plane webhook at: <public-url>/discord/webhooks/plane
# Recommended: map every Plane webhook id to its secret_key (shown in Plane's webhook settings).
# Example: {"3f8b...uuid": "plane_wh_abcdef123456"}
PLANE_WEBHOOK_SECRETS="{}"
# Optional fallback secret used when a webhook id is not present in PLANE_WEBHOOK_SECRETS.
PLANE_WEBHOOK_SECRET=""

# Optional: Redis used to persist work item <-> thread links across restarts.
# When empty an in-memory store is used (links are lost on restart).
REDIS_URL=""
